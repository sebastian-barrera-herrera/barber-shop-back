# ─── App ───
NODE_ENV=development
PORT=4000
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:3000
# Swagger en /api/docs (en producción queda apagado salvo que se active)
SWAGGER_ENABLED=true
# URL pública de esta API y de la web
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Carpeta de archivos subidos (logos, fotos)
UPLOADS_DIR=uploads

# ─── Base de datos ───
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://studio:studio@localhost:5432/studio?schema=public

# ─── Auth ───
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# true en producción (HTTPS)
COOKIE_SECURE=false
# Opcional: dominio de la cookie (ej: .tudominio.com) si front y API usan subdominios
COOKIE_DOMAIN=

# ─── Cifrado de credenciales (pagos) ───
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ─── Wompi (fase 2; fallback si el negocio no configuró sus llaves en el panel) ───
WOMPI_ENVIRONMENT=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ─── Correo (SMTP) ───
# Cualquier proveedor SMTP: Gmail, Resend, Amazon SES, Mailgun… Vacío = no se envían correos.
# En desarrollo: `docker compose up -d mail` y usa SMTP_HOST=localhost, SMTP_PORT=1025 (bandeja en http://localhost:8025)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Studio <no-reply@tudominio.com>

# ─── Recordatorios (necesitan un canal hacia el cliente: email/WhatsApp/SMS) ───
REMINDERS_ENABLED=false

# ─── Seed (datos demo) ───
SEED_ADMIN_EMAIL=admin@studio.local
SEED_ADMIN_PASSWORD=
