// Studio Booking — modelo de datos
// Convenciones:
//  - Todas las tablas del negocio llevan `businessId` (multi-tenant, esquema compartido).
//  - Fechas en UTC (`timestamptz`). La zona horaria del negocio vive en Business.timezone.
//  - Dinero en enteros (centavos). Nunca Float.
//  - La restricción anti-solapamiento de citas está en la migración SQL (btree_gist).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum BusinessType {
  BARBERSHOP
  SALON
  SPA
  NAILS
  AESTHETICS
  OTHER
}

enum Role {
  OWNER
  ADMIN
  PROFESSIONAL
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  WEB
  ADMIN
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  ONLINE
  OTHER
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentEnvironment {
  SANDBOX
  PRODUCTION
}

enum ChannelType {
  WEB
  WHATSAPP
  INSTAGRAM
  MESSENGER
  TELEGRAM
}

enum MessageSender {
  CUSTOMER
  STAFF
  SYSTEM
}

// ───────────────────────────── Negocio ──────────────────────────────

model Business {
  id           String       @id @default(uuid()) @db.Uuid
  slug         String       @unique
  name         String
  type         BusinessType @default(OTHER)
  description  String?
  phone        String?
  email        String?
  whatsapp     String?
  address      String?
  city         String?
  country      String       @default("CO")
  latitude     Decimal?     @db.Decimal(9, 6)
  longitude    Decimal?     @db.Decimal(9, 6)
  timezone     String       @default("America/Bogota")
  currency     String       @default("COP")
  locale       String       @default("es-CO")
  logoUrl      String?
  heroImageUrl String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  settings        BusinessSettings?
  users           User[]
  categories      Category[]
  services        Service[]
  professionals   Professional[]
  customers       Customer[]
  appointments    Appointment[]
  timeOff         TimeOff[]
  payments        Payment[]
  paymentConfigs  PaymentProviderConfig[]
  conversations   Conversation[]
  notifications   Notification[]

  @@map("businesses")
}

/// Configuración agrupada por secciones. La forma de cada JSON se valida con zod
/// en `src/modules/business/settings.schema.ts`.
model BusinessSettings {
  businessId   String   @id @db.Uuid
  branding     Json     @default("{}")
  social       Json     @default("{}")
  openingHours Json     @default("[]")
  booking      Json     @default("{}")
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

// ─────────────────────────── Usuarios y auth ─────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  businessId   String    @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional  Professional?
  refreshTokens RefreshToken[]
  messages      Message[]
  notifications Notification[]

  @@index([businessId])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────── Catálogo ───────────────────────────────

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([businessId, slug])
  @@index([businessId, sortOrder])
  @@map("categories")
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @db.Uuid
  categoryId      String?   @db.Uuid
  name            String
  slug            String
  description     String?
  priceCents      Int
  durationMinutes Int
  imageUrl        String?
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  deletedAt       DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  professionals ProfessionalService[]
  appointments  Appointment[]

  @@unique([businessId, slug])
  @@index([businessId, categoryId])
  @@map("services")
}

// ─────────────────────────── Profesionales ──────────────────────────

model Professional {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @db.Uuid
  userId      String?   @unique @db.Uuid
  name        String
  slug        String
  title       String?
  bio         String?
  photoUrl    String?
  specialties String[]  @default([])
  social      Json?
  color       String    @default("#141412")
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  deletedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  business     Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  services     ProfessionalService[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@map("professionals")
}

model ProfessionalService {
  professionalId String @db.Uuid
  serviceId      String @db.Uuid

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@index([serviceId])
  @@map("professional_services")
}

/// Horario semanal. Varias filas por día permiten pausas (09:00–13:00 y 14:00–18:00).
/// weekday: 0 = domingo … 6 = sábado. Minutos desde medianoche en la zona del negocio.
model WorkingHours {
  id             String @id @default(uuid()) @db.Uuid
  professionalId String @db.Uuid
  weekday        Int    @db.SmallInt
  startMinute    Int    @db.SmallInt
  endMinute      Int    @db.SmallInt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, weekday])
  @@map("working_hours")
}

/// Bloqueos puntuales: vacaciones, citas médicas, cierre del local.
/// professionalId null = aplica a todo el negocio.
model TimeOff {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @db.Uuid
  professionalId String?  @db.Uuid
  startsAt       DateTime @db.Timestamptz(3)
  endsAt         DateTime @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([businessId, startsAt])
  @@index([professionalId, startsAt])
  @@map("time_off")
}

// ───────────────────────────── Clientes ─────────────────────────────

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  name       String
  phone      String // E.164, ej: +573001234567
  email      String?
  notes      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
  conversations Conversation[]

  @@unique([businessId, phone])
  @@index([businessId, name])
  @@map("customers")
}

// ────────────────────────────── Citas ───────────────────────────────

model Appointment {
  id                  String            @id @default(uuid()) @db.Uuid
  businessId          String            @db.Uuid
  customerId          String            @db.Uuid
  professionalId      String            @db.Uuid
  serviceId           String            @db.Uuid
  startsAt            DateTime          @db.Timestamptz(3)
  endsAt              DateTime          @db.Timestamptz(3)
  status              AppointmentStatus @default(PENDING)
  source              AppointmentSource @default(WEB)
  // Copias al momento de reservar: cambiar el servicio no altera el historial.
  serviceNameSnapshot String
  priceCents          Int
  durationMinutes     Int
  paymentStatus       PaymentStatus     @default(UNPAID)
  paymentMethod       PaymentMethod?
  notes               String?
  internalNotes       String?
  // Hash del token del enlace "gestionar mi cita" (el token real solo lo recibe el cliente).
  accessTokenHash     String?           @unique
  cancelledAt         DateTime?         @db.Timestamptz(3)
  cancelReason        String?
  reminder24hSentAt   DateTime?         @db.Timestamptz(3)
  reminder2hSentAt    DateTime?         @db.Timestamptz(3)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: NoAction)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: NoAction)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: NoAction)
  payments     Payment[]

  @@index([businessId, startsAt])
  @@index([professionalId, startsAt])
  @@index([customerId])
  @@map("appointments")
}

// ────────────────────────────── Pagos ───────────────────────────────

model Payment {
  id                    String            @id @default(uuid()) @db.Uuid
  businessId            String            @db.Uuid
  appointmentId         String            @db.Uuid
  provider              String // 'wompi' | 'stripe' | 'payu' ...
  providerReference     String            @unique
  providerTransactionId String?           @unique
  amountCents           Int
  currency              String
  status                TransactionStatus @default(PENDING)
  rawPayload            Json?
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: NoAction)

  @@index([businessId, createdAt])
  @@index([appointmentId])
  @@map("payments")
}

/// Credenciales por negocio. Los secretos se guardan cifrados (AES-256-GCM) y nunca salen del backend.
model PaymentProviderConfig {
  id               String             @id @default(uuid()) @db.Uuid
  businessId       String             @db.Uuid
  provider         String
  environment      PaymentEnvironment @default(SANDBOX)
  publicKey        String?
  encryptedSecrets String?
  isEnabled        Boolean            @default(false)
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, provider])
  @@map("payment_provider_configs")
}

// ────────────────────────────── Chat ────────────────────────────────

model Conversation {
  id                String      @id @default(uuid()) @db.Uuid
  businessId        String      @db.Uuid
  customerId        String      @db.Uuid
  channel           ChannelType @default(WEB)
  externalId        String?
  lastMessageAt     DateTime?   @db.Timestamptz(3)
  unreadForBusiness Int         @default(0)
  createdAt         DateTime    @default(now()) @db.Timestamptz(3)

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([businessId, customerId, channel])
  @@index([businessId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  sender         MessageSender
  userId         String?       @db.Uuid
  body           String
  readAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ────────────────────────── Notificaciones ──────────────────────────

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @db.Uuid
  userId     String?   @db.Uuid
  type       String
  title      String
  body       String?
  data       Json?
  readAt     DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, readAt])
  @@map("notifications")
}
